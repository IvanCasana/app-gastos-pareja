rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function groupExists(groupId) {
      return groupDoc(groupId).data != null;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && groupExists(groupId)
        && request.auth.uid in groupDoc(groupId).data.memberIds;
    }

    function isValidGroupJoin() {
      return signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.size() <= resource.data.maxMembers
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "memberIds",
          "memberNames",
          "updatedAt"
        ]);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      allow get: if isGroupMember(groupId);
      allow list: if signedIn();

      allow update: if isGroupMember(groupId) || isValidGroupJoin();

      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow read: if isGroupMember(resource.data.groupId);

      allow create: if signedIn()
        && request.resource.data.createdByUserId == request.auth.uid
        && isGroupMember(request.resource.data.groupId);

      allow update: if signedIn()
        && isGroupMember(resource.data.groupId)
        && resource.data.createdByUserId == request.auth.uid;

      allow delete: if signedIn()
        && isGroupMember(resource.data.groupId)
        && resource.data.createdByUserId == request.auth.uid;
    }
  }
}
