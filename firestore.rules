rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function groupExists(groupId) {
      return groupDoc(groupId).data != null;
    }

    function userExists(userId) {
      return userDoc(userId).data != null;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && groupExists(groupId)
        && request.auth.uid in groupDoc(groupId).data.memberIds;
    }

    function isGroupCreator(groupId) {
      return signedIn()
        && groupExists(groupId)
        && groupDoc(groupId).data.createdBy == request.auth.uid;
    }

    function isValidGroupJoin() {
      return signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && resource.data.maxMembers == 2
        && request.resource.data.maxMembers == 2
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.size() <= 2
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "memberIds",
          "memberNames",
          "updatedAt"
        ]);
    }

    function sharesGroupWithUser(userId) {
      return signedIn()
        && userExists(request.auth.uid)
        && userExists(userId)
        && userDoc(request.auth.uid).data.groupIds.hasAny(userDoc(userId).data.groupIds);
    }

    function isSafeGroupUpdate() {
      return request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.maxMembers == resource.data.maxMembers
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isSafeTransactionUpdate() {
      return request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdByUserId == resource.data.createdByUserId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.maxMembers == 2;

      allow get: if isGroupMember(groupId);
      allow list: if signedIn();

      allow update: if isValidGroupJoin()
        || (isGroupMember(groupId) && isSafeGroupUpdate());

      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow read: if isGroupMember(resource.data.groupId);

      allow create: if signedIn()
        && request.resource.data.createdByUserId == request.auth.uid
        && isGroupMember(request.resource.data.groupId);

      allow update: if signedIn()
        && isGroupMember(resource.data.groupId)
        && resource.data.createdByUserId == request.auth.uid
        && isSafeTransactionUpdate();

      allow delete: if signedIn()
        && isGroupMember(resource.data.groupId)
        && (
          resource.data.createdByUserId == request.auth.uid
          || isGroupCreator(resource.data.groupId)
        );
    }
  }
}
